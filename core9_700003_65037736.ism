<smil>
  <body>
    <switch>
      <video src="/app/.git/info/exclude"/>
      <video src="/app/.git/logs/HEAD"/>
      <video src="/app/.git/refs/heads/main"/>
      <video src="/app/.git/refs/heads/master"/>
      <video src="/app/.git/logs/refs/heads/main"/>
    </switch>
  </body>
</smil>
